// SPDX-License-Identifier: Apache-2.0
param memcpy_params;
param W: u16;
const sys = @import_module("<memcpy/memcpy>", memcpy_params);
const clock = @import_module("<time>");
var data = @zeros([W]u32);
var seen = @zeros([W]u32);
var start = @zeros([3]u16);
var finish = @zeros([3]u16);
var work_start = @zeros([3]u16);
// start[3], end[3], start/end generation, work, kind, copied words,
// guard, work_start[3], guard. Every clock limb is a native u32 low16.
var report = @zeros([16]u32);
var data_dsd = @get_dsd(mem1d_dsd, .{.base_address=&data, .extent=W});
var seen_dsd = @get_dsd(mem1d_dsd, .{.base_address=&seen, .extent=W});
var ptr_data: [*]u32 = &data;
const ptr_seen: [*]u32 = &seen;
const ptr_report: [*]u32 = &report;

fn init() void {
  clock.enable_tsc();
  report[11] = 0x5a17c10c;
  report[15] = 0xc10c5a17;
  sys.unblock_cmd_stream();
}
fn begin(generation: u16, kind: u16) void {
  @assert(report[6] == report[7]);
  @assert(@as(u32, generation) == report[7] + 1);
  report[6] = @as(u32, generation);
  report[9] = @as(u32, kind);
  clock.get_timestamp(&start);
  for (@range(u16, 3)) |i| { report[i] = @as(u32, start[i]); }
}
fn complete(work: u16) void {
  clock.get_timestamp(&work_start);
  var count: u16 = 0;
  while (count < work) : (count += 1) {
    @mov32(seen_dsd, data_dsd);
  }
  clock.get_timestamp(&finish);
  for (@range(u16, 3)) |i| {
    report[3+i] = @as(u32, finish[i]);
    report[12+i] = @as(u32, work_start[i]);
  }
  report[7] = report[6];
  report[8] = @as(u32, work);
  report[10] = @as(u32, W) * @as(u32, work);
  sys.unblock_cmd_stream();
}
fn tic(generation: u16) void {
  begin(generation, 0);
  sys.unblock_cmd_stream();
}
fn toc(work: u16) void { complete(work); }
fn internal(generation: u16, work: u16) void {
  begin(generation, 1);
  complete(work);
}
comptime {
  @export_symbol(ptr_data, "data");
  @export_symbol(ptr_seen, "seen");
  @export_symbol(ptr_report, "report");
  @export_symbol(init);
  @export_symbol(tic);
  @export_symbol(toc);
  @export_symbol(internal);
}
