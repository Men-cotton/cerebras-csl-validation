let hin=color(0)
let hout=color(1)
let down=color(23)
let odd=color(21)
let even=color(20)
let o0=tile(0 0)
o0 : code('owner [X:0 P:4 R:32 F:16 Q:48 E:128 RELU:0 FRAMES:6 rx:hin tx:down])
o0 : paint(hin [L>CR])
o0 : paint(down [C>U])
let g0=tile(0 1)
g0 : code('collect [OWN:1584 TRAILING:4752 local_rx:down right_rx:even tx:hout])
g0 : paint(down [D>C])
g0 : paint(hout [C>L])
g0 : paint(even [R>C])
let o1=tile(1 0)
o1 : code('owner [X:1 P:4 R:32 F:16 Q:48 E:128 RELU:0 FRAMES:6 rx:hin tx:down])
o1 : paint(hin [L>CR])
o1 : paint(down [C>U])
let g1=tile(1 1)
g1 : code('collect [OWN:1584 TRAILING:3168 local_rx:down right_rx:odd tx:even])
g1 : paint(down [D>C])
g1 : paint(even [C>L])
g1 : paint(odd [R>C])
let o2=tile(2 0)
o2 : code('owner [X:2 P:4 R:32 F:16 Q:48 E:128 RELU:0 FRAMES:6 rx:hin tx:down])
o2 : paint(hin [L>CR])
o2 : paint(down [C>U])
let g2=tile(2 1)
g2 : code('collect [OWN:1584 TRAILING:1584 local_rx:down right_rx:even tx:odd])
g2 : paint(down [D>C])
g2 : paint(odd [C>L])
g2 : paint(even [R>C])
let o3=tile(3 0)
o3 : code('owner [X:3 P:4 R:32 F:16 Q:48 E:128 RELU:0 FRAMES:6 rx:hin tx:down])
o3 : paint(hin [L>C])
o3 : paint(down [C>U])
let g3=tile(3 1)
g3 : code('collect [OWN:1584 TRAILING:0 local_rx:down right_rx:odd tx:even])
g3 : paint(down [D>C])
g3 : paint(even [C>L])
union(o0 g0 o1 g1 o2 g2 o3 g3)
