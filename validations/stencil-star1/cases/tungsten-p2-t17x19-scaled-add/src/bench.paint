(* Each color pair routes one word exactly one hop. In Paint, U increases
   the physical row ID. Logical y increases with the CSL row-major array. *)
let host_in = color(0)
let host_out = color(1)
let e = color()
let w = color()
let s = color()
let n = color()
let et = color()
let wt = color()
let st = color()
let nt = color()
let routes = rect(0 0 C R)
routes : paint(et [CXR])
routes : paint(e [LXC])
routes : colorpair(et e)
routes : paint(wt [CXL])
routes : paint(w [RXC])
routes : colorpair(wt w)
routes : paint(st [CXU])
routes : paint(s [DXC])
routes : colorpair(st s)
routes : paint(nt [CXD])
routes : paint(n [UXC])
routes : colorpair(nt n)

let worker = tile()
worker : code('stencil [host_in:host_in host_out:host_out east:e west:w south:s north:n C:C R:R TX:TX TY:TY E:E])
worker : hstackrep(C 0 'x)
worker : vstackrep(R 0 'y)
worker : name('grid)
let ingress = tile(0 0)
ingress : paint(host_in [L>C])
let egress = tile(0 1)
egress : paint(host_out [C>L])
let fabric = union(routes worker ingress egress)
fabric
