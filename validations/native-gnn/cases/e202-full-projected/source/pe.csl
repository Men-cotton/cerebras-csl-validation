// SPDX-License-Identifier: Apache-2.0
// Complete H128 normalized physical model step, with S untied processors.
// Graph-owner rows hold ceil-padded banks of ALL model weights, uploaded once.
// Each affine shard is broadcast from its bank(s) once, then reused by all
// local items before the column consumption barrier allows the next layer.
param memcpy_params;
param c2d_params;
param C: u16;
param R: u16;
param H: u16;
param T: u16;
param L: u16;
param E: u16;
param MODE: u16;
param HCAP: u16;
param K: u16;
param Q: u16;
param S: u16;
param PROJECTED: u16;
const sys = @import_module("<memcpy/memcpy>",memcpy_params);
const math = @import_module("<math>");
const tsc = @import_module("<time>");
const mx = @import_module("<collectives_2d/pe>",.{
  .dim_params=c2d_params.x,.queues=[2]u16{2,4},
  .dest_dsr_ids=[1]u16{1},.src0_dsr_ids=[1]u16{1},.src1_dsr_ids=[1]u16{1}
});
const my = @import_module("<collectives_2d/pe>",.{
  .dim_params=c2d_params.y,.queues=[2]u16{3,5},
  .dest_dsr_ids=[1]u16{2},.src0_dsr_ids=[1]u16{2},.src1_dsr_ids=[1]u16{2}
});
const progress_id = @get_local_task_id(12);
const halo = @import_module(if (MODE == 0) "no_halo.csl" else "sliced_halo.csl",.{
  .C=C,.R=R,.F=T,.L=L,.E=E,.T=HCAP,.K=K,.done_task=progress_id
});
const W = (@as(u32,7)+9*@as(u32,S))*@as(u32,H)*@as(u32,T)+(@as(u32,27)+10*@as(u32,S))*@as(u32,T);
const B = @as(u16,(W+@as(u32,R)-1)/@as(u32,R));
const A = 3*H*T+T;
var counts = @zeros([2]u32);
var src_owner = @zeros([E]u32);
var src_slot = @zeros([E]u32);
var dst_slot = @zeros([E]u32);
var velocity = @zeros([2*L]f32);
var node_type = @zeros([L]u32);
var geometry = @zeros([3*E]f32);
var normalizers = @zeros([32]f32);
var bank = @zeros([B]f32);
var h_out = @zeros([L*T]f32);
var e_out = @zeros([E*T]f32);
var delta_h = @zeros([L*T]f32);
var delta_e = @zeros([E*T]f32);
var aggregate = @zeros([L*T]f32);
var sender_cache = @zeros([E*T]f32);
// First-edge-affine projections use the same output-feature ownership as h_out.
// PROJECTED=0 never references these private arrays.
var projected_src = @zeros([L*T]f32);
var projected_dst = @zeros([L*T]f32);
var encoded_h = @zeros([L*T]f32);
var cached_e0 = @zeros([E*T]f32);
var decoder_output = @zeros([2*L]f32);
var velocity_out = @zeros([2*L]f32);
// Each graph owner stores its role in every source-turn or colored round.
// R is the idle sentinel; no all-owner node panel is allocated.
var round_sources = @zeros([Q]u32);
var active_weights = @zeros([A]f32);
var input = @zeros([3*H]f32);
// Inter-layer activations remain feature-sharded. Only the current item is
// reconstructed in input[3*H], so adding local edges does not replicate H.
var work = @zeros([E*T]f32);
var output = @zeros([T]f32);
var done = @zeros([1]f32);
var release = @zeros([1]f32);
var global_total = @zeros([1]f32);
// magic, layers, bank chunks, weight words, items, MACs, input gathers,
// input broadcasts, activation gathers, activation broadcasts, barriers,
// including two projection items/node and one projection barrier/block when enabled.
// MODE0: source broadcasts, copies, x,y,runs,column source barriers/rounds.
// MODE1/2: block halos, copies, x,y,runs,global source barriers/rounds.
var stats = @zeros([18]u32);
var clocks = @zeros([6]u16);
var px: u16 = 0;
var py: u16 = 0;
var phase: u16 = 0;
var source: u16 = 0;
var round: u16 = 0;
var layer: u16 = 0;
var bank_source: u16 = 0;
var layer_base: u32 = 0;
var layer_size: u16 = 0;
var input_size: u16 = 0;
var item: u16 = 0;
var item_count: u16 = 0;
var segment: u16 = 0;
var bank_words: u16 = 0;
var global_action: u16 = 0;
var role: u16 = 0;
var generation: u32 = 0;
const out_dsd = @get_dsd(mem1d_dsd,.{.tensor_access=|i|{T}->output[i]});

noinline fn begin_barrier() void {
  done[0] = 1.0; release[0] = 0.0;
  phase = 30;
  my.reduce_fadds(0,&done,&release,1,progress_id);
}

noinline fn begin_halo_barrier(action: u16) void {
  // Required by the message-passing contract before the first source and
  // after every consumed source round. This is distinct from weight reuse.
  global_action = action;
  done[0] = 1.0; release[0] = 0.0; global_total[0] = 0.0;
  phase = 40;
  mx.reduce_fadds(0,&done,&release,1,progress_id);
}

noinline fn begin_selective_source() void {
  if (comptime MODE > 0) {
    source = @as(u16,round_sources[round]);
    @assert(source <= R);
    phase = 50;
    if (comptime PROJECTED == 1) {
      halo.start(source,generation,&projected_src,&sender_cache,&src_owner,&src_slot);
    } else {
      halo.start(source,generation,&h_out,&sender_cache,&src_owner,&src_slot);
    }
  }
}

noinline fn begin_streamed_source() void {
  if (comptime MODE == 0) {
    // The preceding layer's column barrier has consumed every local update
    // for this feature lane. Only one source owner's slice is live here.
    if (py == source) {
      for (@range(u16,L*T)) |i| {
        if (comptime PROJECTED == 1) { halo.source_panel[i] = projected_src[i]; }
        else { halo.source_panel[i] = h_out[i]; }
      }
    }
    phase = 60;
    my.broadcast(source,@ptrcast([*]u32,&halo.source_panel),L*T,progress_id);
  }
}

noinline fn affine() void {
  if (comptime PROJECTED == 1) {
    if (layer%3 == 0 and role >= 2 and role < 2*S+2 and role%2 == 0) {
      // Keep input_size=3H for the resident bank layout. Only the edge latent
      // remains to be multiplied here; both node terms were computed once.
      const dst = @as(u16,dst_slot[item]);
      for (@range(u16,T)) |i| {
        output[i] = (sender_cache[item*T+i]+projected_dst[dst*T+i])+active_weights[3*H*T+i];
      }
      var edge_w = @set_dsd_base_addr(out_dsd,@ptrcast([*]f32,&active_weights[2*H*T]));
      for (@range(u16,H)) |i| {
        @fmacs(out_dsd,out_dsd,edge_w,input[i]);
        edge_w = @increment_dsd_offset(edge_w,@as(i16,T),f32);
      }
      // The nonlinearity follows the complete three-term affine and bias.
      for (@range(u16,T)) |i| {
        if (output[i] < 0.0) { output[i] = 0.0; }
        work[item*T+i] = output[i];
      }
      stats[4] += 1;
      stats[5] += @as(u32,H)*@as(u32,T);
      item += 1;
      begin_item();
      return;
    }
  }
  const bias = @set_dsd_base_addr(out_dsd,@ptrcast([*]f32,&active_weights[input_size*T]));
  @fmovs(out_dsd,bias);
  var w = @set_dsd_base_addr(out_dsd,@ptrcast([*]f32,&active_weights[0]));
  for (@range(u16,input_size)) |i| {
    @fmacs(out_dsd,out_dsd,w,input[i]);
    w = @increment_dsd_offset(w,@as(i16,T),f32);
  }
  if (layer%3 < 2) {
    for (@range(u16,T)) |i| {
      if (output[i] < 0.0) { output[i] = 0.0; }
    }
  }
  stats[4] += 1;
  stats[5] += @as(u32,input_size)*@as(u32,T);
  if (layer%3 < 2) {
    for (@range(u16,T)) |i| { work[item*T+i] = output[i]; }
    item += 1;
    begin_item();
  } else {
    // The final affine needs the full current item for LayerNorm only.
    phase = 20;
    mx.gather(0,@ptrcast([*]u32,&output),@ptrcast([*]u32,&input),T,progress_id);
  }
}

noinline fn gather_input() void {
  if (comptime PROJECTED == 1) {
    if (role >= 2 and role < 2*S+2 and role%2 == 0) {
      phase = 75;
      mx.gather(0,@ptrcast([*]u32,&e_out[item*T]),@ptrcast([*]u32,&input),T,progress_id);
      return;
    }
  }
  phase = 10;
  if (role >= 2 and role < 2*S+2 and role%2 == 0) {
    if (segment == 0) {
      mx.gather(0,@ptrcast([*]u32,&sender_cache[item*T]),@ptrcast([*]u32,&input[segment*H]),T,progress_id);
    } else if (segment == 1) {
      mx.gather(0,@ptrcast([*]u32,&h_out[@as(u16,dst_slot[item])*T]),@ptrcast([*]u32,&input[segment*H]),T,progress_id);
    } else {
      mx.gather(0,@ptrcast([*]u32,&e_out[item*T]),@ptrcast([*]u32,&input[segment*H]),T,progress_id);
    }
  } else {
    if (segment == 0) {
      mx.gather(0,@ptrcast([*]u32,&h_out[item*T]),@ptrcast([*]u32,&input[segment*H]),T,progress_id);
    } else {
      mx.gather(0,@ptrcast([*]u32,&aggregate[item*T]),@ptrcast([*]u32,&input[segment*H]),T,progress_id);
    }
  }
}

noinline fn begin_item() void {
  if (item == item_count) { begin_barrier(); }
  else if (layer%3 == 0 and role == 0) {
    @assert(node_type[item] < 9);
    for (@range(u16,11)) |i| {
      var value: f32 = 0.0;
      if (i < 2) { value = velocity[2*item+i]; }
      else if (@as(u32,i-2) == node_type[item]) { value = 1.0; }
      input[i] = (value-normalizers[i])/normalizers[11+i];
    }
    phase = 14; @activate(progress_id);
  }
  else if (layer%3 == 0 and role == 1) {
    for (@range(u16,3)) |i| {
      input[i] = (geometry[3*item+i]-normalizers[22+i])/normalizers[25+i];
    }
    phase = 14; @activate(progress_id);
  }
  else if (layer%3 == 0) { segment = 0; gather_input(); }
  else {
    // Restore a single intermediate immediately before its next affine.
    phase = 12;
    mx.gather(0,@ptrcast([*]u32,&work[item*T]),@ptrcast([*]u32,&input),T,progress_id);
  }
}

noinline fn begin_projection() void {
  if (item == @as(u16,counts[0])) {
    // Every source's projection must be ready before this feature column
    // starts its halo. This barrier does not release or advance the bank.
    done[0] = 1.0; release[0] = 0.0;
    phase = 72;
    my.reduce_fadds(0,&done,&release,1,progress_id);
  } else {
    phase = 70;
    mx.gather(0,@ptrcast([*]u32,&h_out[item*T]),@ptrcast([*]u32,&input),T,progress_id);
  }
}

noinline fn project_node() void {
  const src_dsd = @set_dsd_base_addr(out_dsd,@ptrcast([*]f32,&projected_src[item*T]));
  const dst_dsd = @set_dsd_base_addr(out_dsd,@ptrcast([*]f32,&projected_dst[item*T]));
  for (@range(u16,T)) |i| {
    projected_src[item*T+i] = 0.0;
    projected_dst[item*T+i] = 0.0;
  }
  var src_w = @set_dsd_base_addr(out_dsd,@ptrcast([*]f32,&active_weights[0]));
  var dst_w = @set_dsd_base_addr(out_dsd,@ptrcast([*]f32,&active_weights[H*T]));
  for (@range(u16,H)) |i| {
    @fmacs(src_dsd,src_dsd,src_w,input[i]);
    @fmacs(dst_dsd,dst_dsd,dst_w,input[i]);
    src_w = @increment_dsd_offset(src_w,@as(i16,T),f32);
    dst_w = @increment_dsd_offset(dst_w,@as(i16,T),f32);
  }
  stats[4] += 2;
  stats[5] += 2*@as(u32,H)*@as(u32,T);
  item += 1;
  begin_projection();
}

noinline fn next_bank_chunk() void {
  // A layer may span multiple graph-row banks, including a padded final bank.
  // Application payloads copy only the intersecting live shard; SDK collective
  // protocol headers are not counted by this application.
  while (bank_source < R) {
    const bank_begin = @as(u32,bank_source)*@as(u32,B);
    const bank_end = (@as(u32,bank_source)+1)*@as(u32,B);
    var begin: u32 = layer_base;
    if (bank_begin > begin) { begin = bank_begin; }
    var end: u32 = layer_base+@as(u32,layer_size);
    if (bank_end < end) { end = bank_end; }
    if (end > begin) {
      const offset = @as(u16,begin-layer_base);
      bank_words = @as(u16,end-begin);
      if (py == bank_source) {
        for (@range(u16,bank_words)) |i| {
          active_weights[offset+i] = bank[@as(u16,begin-bank_begin)+i];
        }
      }
      phase = 3;
      my.broadcast(bank_source,@ptrcast([*]u32,&active_weights[offset]),bank_words,progress_id);
      return;
    }
    bank_source += 1;
  }
  item = 0;
  // Keep the indices explicit: SDK2.10.2's CSL lowering rejects an untyped
  // runtime-if expression used directly as an array index (E199 diagnosis).
  if (role == 1 or (role >= 2 and role < 2*S+2 and role%2 == 0)) {
    item_count = @as(u16,counts[1]);
  } else {
    item_count = @as(u16,counts[0]);
  }
  if (comptime PROJECTED == 1) {
    if (layer%3 == 0 and role >= 2 and role < 2*S+2 and role%2 == 0) {
      begin_projection();
      return;
    }
  }
  begin_item();
}

noinline fn begin_layer() void {
  role = layer/3;
  input_size = H;
  if (layer%3 == 0) {
    if (role == 0) { input_size = 11; }
    else if (role == 1) { input_size = 3; }
    else if (role < 2*S+2) { input_size = if (role%2 == 0) 3*H else 2*H; }
  }
  layer_size = input_size*T+T;
  if (layer%3 == 2 and role < 2*S+2) { layer_size += 2*T; }
  bank_source = 0;
  next_bank_chunk();
}

noinline fn consume_item() void {
  if (role == 2*S+2) {
    // Padded decoder columns are exactly zero. Physical output is replicated
    // only across the feature lanes of its owning graph group.
    for (@range(u16,2)) |i| {
      decoder_output[2*item+i] = input[i];
      velocity_out[2*item+i] = velocity[2*item+i];
      if (node_type[item] == 0 or node_type[item] == 5) {
        velocity_out[2*item+i] += input[i]*normalizers[30+i]+normalizers[28+i];
      }
    }
  } else {
    var mean: f32 = 0.0;
    for (@range(u16,H)) |i| { mean += input[i]; }
    mean /= @as(f32,H);
    var variance: f32 = 0.0;
    for (@range(u16,H)) |i| {
      const d = input[i]-mean;
      variance += d*d;
    }
    variance /= @as(f32,H);
    const denominator = math.sqrt_f32(variance+@as(f32,1.0e-5));
    const gamma = H*T+T;
    const beta = gamma+T;
    for (@range(u16,T)) |i| {
      const value = ((input[px*T+i]-mean)/denominator)*active_weights[gamma+i]+active_weights[beta+i];
      if (role == 0) {
        h_out[item*T+i] = value; encoded_h[item*T+i] = value;
      } else if (role == 1) {
        e_out[item*T+i] = value; cached_e0[item*T+i] = value;
      } else if (role%2 == 0) {
        delta_e[item*T+i] = value;
        e_out[item*T+i] += value;
        // Aggregate the edge DELTA before residual addition, preserving every
        // duplicate occurrence and the supplied local edge order.
        aggregate[@as(u16,dst_slot[item])*T+i] += value;
      } else {
        delta_h[item*T+i] = value;
        h_out[item*T+i] += value;
      }
    }
  }
  item += 1;
  begin_item();
}

task progress() void {
  if (phase == 3) {
    stats[2] += 1; stats[3] += @as(u32,bank_words);
    bank_source += 1;
    next_bank_chunk();
  } else if (phase == 10) {
    stats[6] += 1;
    segment += 1;
    if (segment < input_size/H) { gather_input(); }
    else {
      phase = 11;
      mx.broadcast(0,@ptrcast([*]u32,&input),input_size,progress_id);
    }
  } else if (phase == 11) {
    stats[7] += 1;
    affine();
  } else if (phase == 12) {
    stats[8] += 1;
    phase = 13;
    mx.broadcast(0,@ptrcast([*]u32,&input),H,progress_id);
  } else if (phase == 13) {
    stats[9] += 1;
    affine();
  } else if (phase == 14) {
    // Break the synchronous item loop for raw encoder inputs. Each affine
    // invocation can schedule the next item without recursive stack growth.
    affine();
  } else if (phase == 20) {
    stats[8] += 1;
    phase = 21;
    mx.broadcast(0,@ptrcast([*]u32,&input),H,progress_id);
  } else if (phase == 21) {
    stats[9] += 1;
    consume_item();
  } else if (phase == 30) {
    phase = 31;
    my.broadcast(0,@ptrcast([*]u32,&release),1,progress_id);
  } else if (phase == 31) {
    @assert(release[0] == @as(f32,R));
    stats[10] += 1; stats[1] += 1;
    layer_base += @as(u32,layer_size);
    layer += 1;
    if (layer >= 6 and layer < 6+6*S and (layer-6)%6 == 0) {
      // All node features from the previous block must be consumed before a
      // new generation of the sliced halo; weights remain resident throughout.
      for (@range(u16,L*T)) |i| { aggregate[i] = 0.0; }
      generation = @as(u32,(layer-6)/6)+1;
      round = 0;
      if (comptime PROJECTED == 1) {
        // Projection consumes the first edge bank before halo traffic starts.
        begin_layer();
      } else if (comptime MODE == 0) {
        source = 0;
        begin_streamed_source();
      } else {
        stats[11] += 1;
        begin_halo_barrier(0);
      }
    } else if (layer < 6*S+9) { begin_layer(); }
    else {
      @assert(layer_base == W);
      tsc.get_timestamp(@ptrcast(*[3]u16,&clocks[3]));
      tsc.disable_tsc();
      stats[0] = 0x600D;
      stats[15] = 1;
      sys.unblock_cmd_stream();
    }
  } else if (phase == 40) {
    phase = 41;
    my.reduce_fadds(0,&release,&global_total,1,progress_id);
  } else if (phase == 41) {
    phase = 42;
    my.broadcast(0,@ptrcast([*]u32,&global_total),1,progress_id);
  } else if (phase == 42) {
    phase = 43;
    mx.broadcast(0,@ptrcast([*]u32,&global_total),1,progress_id);
  } else if (phase == 43) {
    @assert(global_total[0] == @as(f32,C*R));
    stats[16] += 1;
    if (global_action == 0) { begin_selective_source(); }
    else {
      round += 1;
      if (round < Q) { begin_selective_source(); }
      else {
        if (comptime MODE > 0) {
          stats[12] = (halo.comm_stats[6]+halo.comm_stats[7])*@as(u32,T);
        }
        if (comptime PROJECTED == 1) { begin_item(); }
        else { begin_layer(); }
      }
    }
  } else if (phase == 50) {
    stats[17] += 1;
    begin_halo_barrier(1);
  } else if (phase == 60) {
    if (comptime MODE == 0) {
      stats[11] += 1; stats[17] += 1;
      for (@range(u16,@as(u16,counts[1]))) |edge| {
        if (src_owner[edge] == @as(u32,source)) {
          const slot = @as(u16,src_slot[edge]);
          @assert(slot < L);
          for (@range(u16,T)) |feature| {
            sender_cache[edge*T+feature] = halo.source_panel[slot*T+feature];
          }
          stats[12] += @as(u32,T);
        }
      }
      // Every receiver consumes the current panel before ANY owner reuses it.
      done[0] = 1.0; release[0] = 0.0;
      phase = 61;
      my.reduce_fadds(0,&done,&release,1,progress_id);
    }
  } else if (phase == 61) {
    phase = 62;
    my.broadcast(0,@ptrcast([*]u32,&release),1,progress_id);
  } else if (phase == 62) {
    @assert(release[0] == @as(f32,R));
    stats[16] += 1;
    source += 1;
    if (source < R) { begin_streamed_source(); }
    else {
      // Subsequent row gathers wait for all feature lanes before arithmetic.
      // No all-owner panel or additional cross-lane source barrier is needed.
      if (comptime PROJECTED == 1) { begin_item(); }
      else { begin_layer(); }
    }
  } else if (comptime PROJECTED == 1) {
    if (phase == 70) {
      stats[6] += 1;
      phase = 71;
      mx.broadcast(0,@ptrcast([*]u32,&input),H,progress_id);
    } else if (phase == 71) {
      stats[7] += 1;
      project_node();
    } else if (phase == 72) {
      phase = 73;
      my.broadcast(0,@ptrcast([*]u32,&release),1,progress_id);
    } else if (phase == 73) {
      @assert(release[0] == @as(f32,R));
      stats[10] += 1;
      item = 0;
      if (comptime MODE == 0) {
        source = 0;
        begin_streamed_source();
      } else {
        stats[11] += 1;
        begin_halo_barrier(0);
      }
    } else if (phase == 75) {
      stats[6] += 1;
      phase = 76;
      mx.broadcast(0,@ptrcast([*]u32,&input),H,progress_id);
    } else if (phase == 76) {
      stats[7] += 1;
      affine();
    } else { @assert(false); }
  } else { @assert(false); }
}

fn run() void {
  mx.init(); my.init(); px = mx.pe_id; py = my.pe_id;
  @assert(counts[0] <= L and counts[1] <= E);
  for (@range(u16,18)) |i| { stats[i] = 0; }
  for (@range(u16,L*T)) |i| {
    h_out[i] = 0.0; delta_h[i] = 0.0; aggregate[i] = 0.0; encoded_h[i] = 0.0;
    if (comptime PROJECTED == 1) {
      projected_src[i] = 0.0; projected_dst[i] = 0.0;
    }
  }
  for (@range(u16,E*T)) |i| {
    e_out[i] = 0.0; delta_e[i] = 0.0; sender_cache[i] = 0.0; cached_e0[i] = 0.0;
  }
  for (@range(u16,2*L)) |i| { decoder_output[i] = 0.0; velocity_out[i] = 0.0; }
  for (@range(u16,11)) |i| { @assert(normalizers[11+i] > 0.0); }
  for (@range(u16,3)) |i| { @assert(normalizers[25+i] > 0.0); }
  @assert(normalizers[30] > 0.0 and normalizers[31] > 0.0);
  stats[13] = @as(u32,px); stats[14] = @as(u32,py);
  source = 0; round = 0; layer = 0; layer_base = 0;
  if (comptime MODE > 0) { halo.init(px,py); halo.reset_stats(); }
  tsc.enable_tsc(); tsc.get_timestamp(@ptrcast(*[3]u16,&clocks[0]));
  begin_layer();
}

var p_counts: [*]u32 = &counts;
var p_src_owner: [*]u32 = &src_owner;
var p_src_slot: [*]u32 = &src_slot;
var p_dst_slot: [*]u32 = &dst_slot;
var p_velocity: [*]f32 = &velocity;
var p_node_type: [*]u32 = &node_type;
var p_geometry: [*]f32 = &geometry;
var p_normalizers: [*]f32 = &normalizers;
var p_bank: [*]f32 = &bank;
var p_h_out: [*]f32 = &h_out;
var p_e_out: [*]f32 = &e_out;
var p_delta_h: [*]f32 = &delta_h;
var p_delta_e: [*]f32 = &delta_e;
var p_aggregate: [*]f32 = &aggregate;
var p_sender_cache: [*]f32 = &sender_cache;
var p_encoded_h: [*]f32 = &encoded_h;
var p_cached_e0: [*]f32 = &cached_e0;
var p_decoder_output: [*]f32 = &decoder_output;
var p_velocity_out: [*]f32 = &velocity_out;
var p_stats: [*]u32 = &stats;
var p_clocks: [*]u16 = &clocks;
var p_round_sources: [*]u32 = &round_sources;
comptime {
  @bind_local_task(progress,progress_id);
  @export_symbol(p_counts,"counts");
  @export_symbol(p_src_owner,"src_owner");
  @export_symbol(p_src_slot,"src_slot");
  @export_symbol(p_dst_slot,"dst_slot");
  @export_symbol(p_velocity,"velocity");
  @export_symbol(p_node_type,"node_type");
  @export_symbol(p_geometry,"geometry");
  @export_symbol(p_normalizers,"normalizers");
  @export_symbol(p_bank,"bank");
  @export_symbol(p_h_out,"h_out");
  @export_symbol(p_e_out,"e_out");
  @export_symbol(p_delta_h,"delta_h");
  @export_symbol(p_delta_e,"delta_e");
  @export_symbol(p_aggregate,"aggregate");
  @export_symbol(p_sender_cache,"sender_cache");
  @export_symbol(p_encoded_h,"encoded_h");
  @export_symbol(p_cached_e0,"cached_e0");
  @export_symbol(p_decoder_output,"decoder_output");
  @export_symbol(p_velocity_out,"velocity_out");
  @export_symbol(p_stats,"stats");
  @export_symbol(p_clocks,"clocks");
  @export_symbol(halo.p_tx_begin,"tx_begin");
  @export_symbol(halo.p_tx_slots,"tx_slots");
  @export_symbol(halo.p_rx_count,"rx_count");
  @export_symbol(halo.p_rx_slot,"rx_slot");
  @export_symbol(halo.p_comm_stats,"comm_stats");
  @export_symbol(p_round_sources,"round_sources");
  @export_symbol(run);
}
