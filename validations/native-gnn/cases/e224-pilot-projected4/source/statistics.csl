// SPDX-License-Identifier: Apache-2.0
// Shared ordered statistics for the replicated and root-only consumers.
param H: u16;
const math = @import_module("<math>");

noinline fn compute(values: [*]f32, result: [*]f32) void {
  var mean: f32 = 0.0;
  for (@range(u16,H)) |i| { mean += values[i]; }
  mean /= @as(f32,H);
  var variance: f32 = 0.0;
  for (@range(u16,H)) |i| {
    const d = values[i]-mean;
    variance += d*d;
  }
  variance /= @as(f32,H);
  result[0] = mean;
  result[1] = math.sqrt_f32(variance+@as(f32,1.0e-5));
}

fn apply(value: f32, mean: f32, denominator: f32, gamma: f32, beta: f32) f32 {
  return ((value-mean)/denominator)*gamma+beta;
}
