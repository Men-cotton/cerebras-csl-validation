// SPDX-License-Identifier: Apache-2.0
// Full-model, one-sample MeshGraphNet SGD. Host supplies normalized features.
param C: u16;
param R: u16;
param H: u16;
param S: u16;
param L: u16;
param E: u16;
param W: u16;
const memcpy = @import_module("<memcpy/get_params>", .{.width=C, .height=R});
const c2d = @import_module("<collectives_2d/params>");
layout {
  @set_rectangle(C, R);
  @comptime_assert(C >= 2 and R >= 2 and C*R <= 32767);
  @comptime_assert(H == 4 and S == 2);
  @comptime_assert(L >= 1 and E >= 1);
  @comptime_assert((S+1)*L*H <= 32767 and (S+1)*E*H <= 32767);
  @comptime_assert(L*11 <= 32767 and W+2 <= 32767);
  @comptime_assert(@as(u32, W) == (6+9*@as(u32, S))*H*H+(28+10*@as(u32, S))*H+2);
  for (@range(u16, C)) |x| {
    for (@range(u16, R)) |y| {
      const cp = c2d.get_params(x, y, .{
        .x_colors=.{@get_color(0), @get_color(1)},
        .x_entrypoints=.{@get_local_task_id(8), @get_local_task_id(9)},
        .y_colors=.{@get_color(4), @get_color(5)},
        .y_entrypoints=.{@get_local_task_id(10), @get_local_task_id(11)}
      });
      @set_tile_code(x, y, "pe.csl", .{
        .memcpy_params=memcpy.get_params(x), .c2d_params=cp,
        .C=C,.R=R,.H=H,.S=S,.L=L,.E=E,.W=W
      });
    }
  }
  @export_name("counts", [*]u32, true);
  @export_name("src_owner", [*]u32, true);
  @export_name("src_begin", [*]u32, true);
  @export_name("src_slot", [*]u32, true);
  @export_name("dst_slot", [*]u32, true);
  @export_name("node_input", [*]f32, true);
  @export_name("edge_input", [*]f32, true);
  @export_name("target", [*]f32, true);
  @export_name("loss_mask", [*]f32, true);
  @export_name("scalars", [*]f32, true);
  @export_name("weights", [*]f32, true);
  @export_name("prediction", [*]f32, true);
  @export_name("loss", [*]f32, true);
  @export_name("gradients", [*]f32, true);
  @export_name("stats", [*]u32, true);
  @export_name("clocks", [*]u16, true);
  @export_name("lifecycle", [*]u32, true);
  @export_name("run", fn()void);
}
