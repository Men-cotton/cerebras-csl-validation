// SPDX-License-Identifier: Apache-2.0
// Full H4/S2 CFD-model forward/backward and SGD, with receiver-owned edges.
// Flat parameters match reference.weight_layout; all MLPs and LN are trained.
// Official patterns: gemm-collectives_2d queue/DSR ownership, GEMV reduce_fadds,
// topic-02-libraries sqrt/TSC; E134 supplies checked 2D collective sequencing.
param memcpy_params;
param c2d_params;
param C: u16;
param R: u16;
param H: u16;
param S: u16;
param L: u16;
param E: u16;
param W: u16;
const sys = @import_module("<memcpy/memcpy>", memcpy_params);
const math = @import_module("<math>");
const tsc = @import_module("<time>");
const mx = @import_module("<collectives_2d/pe>", .{
  .dim_params=c2d_params.x, .queues=[2]u16{2,4},
  .dest_dsr_ids=[1]u16{1}, .src0_dsr_ids=[1]u16{1}, .src1_dsr_ids=[1]u16{1}
});
const my = @import_module("<collectives_2d/pe>", .{
  .dim_params=c2d_params.y, .queues=[2]u16{3,5},
  .dest_dsr_ids=[1]u16{2}, .src0_dsr_ids=[1]u16{2}, .src1_dsr_ids=[1]u16{2}
});
const progress_id = @get_local_task_id(12);
const P = C*R;
const INPUT = if (3*H > 11) 3*H else 11;
const NODE_ENCODER_SIZE = 2*H*H+16*H;
const EDGE_ENCODER_SIZE = 2*H*H+8*H;
const EDGE_BLOCK_SIZE = 5*H*H+5*H;
const BLOCK_SIZE = 9*H*H+10*H;
const PROCESSOR_BASE = NODE_ENCODER_SIZE+EDGE_ENCODER_SIZE;
const DECODER_BASE = PROCESSOR_BASE+S*BLOCK_SIZE;

var counts = @zeros([2]u32);
var src_owner = @zeros([E]u32);
var src_begin = @zeros([P+1]u32);
var src_slot = @zeros([E]u32);
var dst_slot = @zeros([E]u32);
var node_input = @zeros([L*11]f32);
var edge_input = @zeros([E*3]f32);
var target = @zeros([L*2]f32);
var loss_mask = @zeros([L]f32);
// learning rate; inverse global count of supervised NORMAL/OUTFLOW nodes.
var scalars = @zeros([2]f32);
var weights = @zeros([W]f32);
var prediction = @zeros([L*2]f32);
var loss = @zeros([1]f32);
// Last two reduction lanes hold normalized local loss and active node count.
// Only the first W entries of gradients form the exported parameter gradient.
// Row reduction consumes local gradients before the column reduction reuses
// that same array for the global result; callbacks delimit its lifetime.
var row_grad = @zeros([W+2]f32);
var gradients = @zeros([W+2]f32);

// Histories are pre-update activations. MLP intermediate vectors are recomputed
// one item at a time; sender_cache is refilled for each forward/reverse block.
var h_history = @zeros([(S+1)*L*H]f32);
var e_history = @zeros([(S+1)*E*H]f32);
var aggregate_history = @zeros([S*L*H]f32);
var dh = @zeros([L*H]f32);
var dh_previous = @zeros([L*H]f32);
var daggregate = @zeros([L*H]f32);
var de = @zeros([E*H]f32);
// During backward each consumed sender activation becomes its cotangent.
var sender_cache = @zeros([E*H]f32);
var panel = @zeros([L*H]f32);
var panel_row = @zeros([L*H]f32);
var panel_sum = @zeros([L*H]f32);

var mlp_input = @zeros([INPUT]f32);
var hidden_a = @zeros([H]f32);
var hidden_b = @zeros([H]f32);
var mlp_output = @zeros([H]f32);
var normalized = @zeros([H]f32);
var output_grad = @zeros([H]f32);
var hidden_a_grad = @zeros([H]f32);
var hidden_b_grad = @zeros([H]f32);
var input_grad = @zeros([INPUT]f32);
var inverse_std: f32 = 0.0;

var done_local = @zeros([1]f32);
var done_row = @zeros([1]f32);
var release = @zeros([1]f32);
// magic, updates_this_call, forward_blocks, edge_encodes, node_encodes,
// edge_forward, node_forward, decoder_forward, panels, barriers,
// backward_MLPs, reverse_owner_reductions, parameter_allreduces,
// local_nodes, local_edges, error.
var stats = @zeros([16]u32);
var clocks = @zeros([6]u16);
// collective initialization count (0/1), completed SGD updates.
var lifecycle = @zeros([2]u32);
var px: u16 = 0;
var py: u16 = 0;
var block: u16 = 0;
var source_owner: u16 = 0;
var phase: u16 = 0;
var barrier_action: u16 = 0;
var reversing: bool = false;

noinline fn affine(input: [*]f32, output: [*]f32, ni: u16, no: u16, base: u16) void {
  for (@range(u16, no)) |j| {
    var value = weights[base+ni*no+j];
    for (@range(u16, ni)) |i| { value += input[i]*weights[base+i*no+j]; }
    output[j] = value;
  }
}

fn mlp(ni: u16, no: u16, base: u16, normalize: bool) void {
  affine(&mlp_input, &hidden_a, ni, H, base);
  for (@range(u16, H)) |i| { if (hidden_a[i] < 0.0) { hidden_a[i] = 0.0; } }
  const second = base+ni*H+H;
  affine(&hidden_a, &hidden_b, H, H, second);
  for (@range(u16, H)) |i| { if (hidden_b[i] < 0.0) { hidden_b[i] = 0.0; } }
  const third = second+H*H+H;
  affine(&hidden_b, &mlp_output, H, no, third);
  if (normalize) {
    var mean: f32 = 0.0;
    for (@range(u16, no)) |i| { mean += mlp_output[i]; }
    mean /= @as(f32, no);
    var variance: f32 = 0.0;
    for (@range(u16, no)) |i| {
      const centered = mlp_output[i]-mean;
      variance += centered*centered;
    }
    variance /= @as(f32, no);
    inverse_std = @as(f32, 1.0)/math.sqrt_f32(variance+@as(f32, 1.0e-5));
    const gamma = third+H*no+no;
    for (@range(u16, no)) |i| {
      normalized[i] = (mlp_output[i]-mean)*inverse_std;
      mlp_output[i] = normalized[i]*weights[gamma+i]+weights[gamma+no+i];
    }
  }
}

// The caller has just recomputed mlp() with unchanged weights. dx is assigned;
// dW/db accumulate over all local node/edge occurrences, including duplicates.
noinline fn affine_backward(input: [*]f32, dy: [*]f32, dx: [*]f32,
                   ni: u16, no: u16, base: u16) void {
  for (@range(u16, no)) |j| { gradients[base+ni*no+j] += dy[j]; }
  for (@range(u16, ni)) |i| {
    var value: f32 = 0.0;
    for (@range(u16, no)) |j| {
      gradients[base+i*no+j] += input[i]*dy[j];
      value += weights[base+i*no+j]*dy[j];
    }
    dx[i] = value;
  }
}

fn mlp_backward(ni: u16, no: u16, base: u16, normalize: bool) void {
  const second = base+ni*H+H;
  const third = second+H*H+H;
  if (normalize) {
    const gamma = third+H*no+no;
    var sum_dy: f32 = 0.0;
    var sum_dy_xhat: f32 = 0.0;
    for (@range(u16, no)) |i| {
      gradients[gamma+i] += output_grad[i]*normalized[i];
      gradients[gamma+no+i] += output_grad[i];
      output_grad[i] *= weights[gamma+i];
      sum_dy += output_grad[i];
      sum_dy_xhat += output_grad[i]*normalized[i];
    }
    const width = @as(f32, no);
    for (@range(u16, no)) |i| {
      output_grad[i] = inverse_std*(output_grad[i]-sum_dy/width-normalized[i]*sum_dy_xhat/width);
    }
  }
  affine_backward(&hidden_b, &output_grad, &hidden_b_grad, H, no, third);
  for (@range(u16, H)) |i| { if (hidden_b[i] <= 0.0) { hidden_b_grad[i] = 0.0; } }
  affine_backward(&hidden_a, &hidden_b_grad, &hidden_a_grad, H, H, second);
  for (@range(u16, H)) |i| { if (hidden_a[i] <= 0.0) { hidden_a_grad[i] = 0.0; } }
  affine_backward(&mlp_input, &hidden_a_grad, &input_grad, ni, H, base);
  stats[10] += 1;
}

// A collective callback has released every buffer before the next action.
// The final broadcast includes every PE, even empty owners.
noinline fn begin_barrier(action: u16) void {
  barrier_action = action;
  done_local[0] = 1.0; done_row[0] = 0.0; release[0] = 0.0;
  phase = 10;
  mx.reduce_fadds(0, &done_local, &done_row, 1, progress_id);
}

noinline fn begin_panel() void {
  for (@range(u16, L*H)) |i| { panel[i] = 0.0; }
  phase = 1;
  if (py == source_owner/C) {
    if (px == source_owner%C) {
      for (@range(u16, L*H)) |i| { panel[i] = h_history[block*L*H+i]; }
    }
    mx.broadcast(source_owner%C, @ptrcast([*]u32, &panel), L*H, progress_id);
  } else { @activate(progress_id); }
}

fn consume_panel() void {
  const lo = src_begin[source_owner];
  const hi = src_begin[source_owner+1];
  @assert(lo <= hi and hi <= counts[1]);
  var edge = @as(u16, lo);
  while (@as(u32, edge) < hi) : (edge += 1) {
    @assert(src_owner[edge] == @as(u32, source_owner) and src_slot[edge] < @as(u32, L));
    const src = @as(u16, src_slot[edge]);
    for (@range(u16, H)) |f| { sender_cache[edge*H+f] = panel[src*H+f]; }
  }
  stats[8] += 1;
  begin_barrier(1);
}

fn forward_block() void {
  const edge_base = PROCESSOR_BASE+block*BLOCK_SIZE;
  for (@range(u16, E)) |edge| {
    if (@as(u32, edge) < counts[1]) {
      const dst = @as(u16, dst_slot[edge]);
      @assert(dst_slot[edge] < counts[0]);
      for (@range(u16, H)) |f| {
        mlp_input[f] = sender_cache[edge*H+f];
        mlp_input[H+f] = h_history[block*L*H+dst*H+f];
        mlp_input[2*H+f] = e_history[block*E*H+edge*H+f];
      }
      mlp(3*H, H, edge_base, true);
      for (@range(u16, H)) |f| {
        aggregate_history[block*L*H+dst*H+f] += mlp_output[f];
        e_history[(block+1)*E*H+edge*H+f] = e_history[block*E*H+edge*H+f]+mlp_output[f];
      }
      stats[5] += 1;
    }
  }
  const node_base = edge_base+EDGE_BLOCK_SIZE;
  for (@range(u16, L)) |v| {
    if (@as(u32, v) < counts[0]) {
      for (@range(u16, H)) |f| {
        mlp_input[f] = h_history[block*L*H+v*H+f];
        mlp_input[H+f] = aggregate_history[block*L*H+v*H+f];
      }
      mlp(2*H, H, node_base, true);
      for (@range(u16, H)) |f| {
        h_history[(block+1)*L*H+v*H+f] = h_history[block*L*H+v*H+f]+mlp_output[f];
      }
      stats[6] += 1;
    }
  }
  stats[2] += 1;
  block += 1;
  if (block < S) { begin_barrier(0); }
  else { decode_backward(); }
}

fn decode_backward() void {
  for (@range(u16, L)) |v| {
    if (@as(u32, v) < counts[0]) {
      @assert(loss_mask[v] == 0.0 or loss_mask[v] == 1.0);
      gradients[W+1] += loss_mask[v];
      for (@range(u16, H)) |f| { mlp_input[f] = h_history[S*L*H+v*H+f]; }
      mlp(H, 2, DECODER_BASE, false);
      for (@range(u16, 2)) |f| {
        prediction[v*2+f] = mlp_output[f];
        const error = mlp_output[f]-target[v*2+f];
        gradients[W] += error*error*loss_mask[v]*scalars[1];
        output_grad[f] = @as(f32, 2.0)*error*loss_mask[v]*scalars[1];
      }
      mlp_backward(H, 2, DECODER_BASE, false);
      for (@range(u16, H)) |f| { dh[v*H+f] = input_grad[f]; }
      stats[7] += 1;
    }
  }
  reversing = true;
  block = S-1;
  begin_barrier(0);
}

fn backward_block() void {
  const edge_base = PROCESSOR_BASE+block*BLOCK_SIZE;
  const node_base = edge_base+EDGE_BLOCK_SIZE;
  for (@range(u16, L*H)) |i| { dh_previous[i] = 0.0; daggregate[i] = 0.0; }
  for (@range(u16, L)) |v| {
    if (@as(u32, v) < counts[0]) {
      for (@range(u16, H)) |f| {
        mlp_input[f] = h_history[block*L*H+v*H+f];
        mlp_input[H+f] = aggregate_history[block*L*H+v*H+f];
        output_grad[f] = dh[v*H+f];
      }
      mlp(2*H, H, node_base, true);
      mlp_backward(2*H, H, node_base, true);
      for (@range(u16, H)) |f| {
        dh_previous[v*H+f] = dh[v*H+f]+input_grad[f];
        daggregate[v*H+f] = input_grad[H+f];
      }
    }
  }
  for (@range(u16, E)) |edge| {
    if (@as(u32, edge) < counts[1]) {
      const dst = @as(u16, dst_slot[edge]);
      for (@range(u16, H)) |f| {
        mlp_input[f] = sender_cache[edge*H+f];
        mlp_input[H+f] = h_history[block*L*H+dst*H+f];
        mlp_input[2*H+f] = e_history[block*E*H+edge*H+f];
        output_grad[f] = de[edge*H+f]+daggregate[dst*H+f];
      }
      mlp(3*H, H, edge_base, true);
      mlp_backward(3*H, H, edge_base, true);
      for (@range(u16, H)) |f| {
        sender_cache[edge*H+f] = input_grad[f];
        dh_previous[dst*H+f] += input_grad[H+f];
        de[edge*H+f] += input_grad[2*H+f];
      }
    }
  }
  begin_barrier(2);
}

fn begin_reverse_owner() void {
  for (@range(u16, L*H)) |i| { panel[i] = 0.0; panel_row[i] = 0.0; panel_sum[i] = 0.0; }
  var edge = @as(u16, src_begin[source_owner]);
  const end = @as(u16, src_begin[source_owner+1]);
  while (edge < end) : (edge += 1) {
    const src = @as(u16, src_slot[edge]);
    for (@range(u16, H)) |f| { panel[src*H+f] += sender_cache[edge*H+f]; }
  }
  phase = 20;
  mx.reduce_fadds(source_owner%C, &panel, &panel_row, L*H, progress_id);
}

fn backward_encoders() void {
  for (@range(u16, L)) |v| {
    if (@as(u32, v) < counts[0]) {
      for (@range(u16, 11)) |f| { mlp_input[f] = node_input[v*11+f]; }
      for (@range(u16, H)) |f| { output_grad[f] = dh[v*H+f]; }
      mlp(11, H, 0, true);
      mlp_backward(11, H, 0, true);
    }
  }
  for (@range(u16, E)) |edge| {
    if (@as(u32, edge) < counts[1]) {
      for (@range(u16, 3)) |f| { mlp_input[f] = edge_input[edge*3+f]; }
      for (@range(u16, H)) |f| { output_grad[f] = de[edge*H+f]; }
      mlp(3, H, NODE_ENCODER_SIZE, true);
      mlp_backward(3, H, NODE_ENCODER_SIZE, true);
    }
  }
  phase = 30;
  mx.reduce_fadds(0, &gradients, &row_grad, W+2, progress_id);
}

task progress() void {
  if (phase == 1) {
    phase = 2;
    my.broadcast(source_owner/C, @ptrcast([*]u32, &panel), L*H, progress_id);
  } else if (phase == 2) {
    consume_panel();
  } else if (phase == 10) {
    phase = 11;
    if (px == 0) { my.reduce_fadds(0, &done_row, &release, 1, progress_id); }
    else { @activate(progress_id); }
  } else if (phase == 11) {
    phase = 12;
    if (px == 0) { my.broadcast(0, @ptrcast([*]u32, &release), 1, progress_id); }
    else { @activate(progress_id); }
  } else if (phase == 12) {
    phase = 13;
    mx.broadcast(0, @ptrcast([*]u32, &release), 1, progress_id);
  } else if (phase == 13) {
    @assert(release[0] == @as(f32, P));
    stats[9] += 1;
    if (barrier_action == 0) { source_owner = 0; begin_panel(); }
    else if (barrier_action == 1) {
      source_owner += 1;
      if (source_owner < P) { begin_panel(); }
      else if (reversing) { backward_block(); }
      else { forward_block(); }
    } else if (barrier_action == 2) { source_owner = 0; begin_reverse_owner(); }
    else if (barrier_action == 3) {
      source_owner += 1;
      if (source_owner < P) { begin_reverse_owner(); }
      else {
        for (@range(u16, L*H)) |i| { dh[i] = dh_previous[i]; }
        if (block > 0) { block -= 1; begin_barrier(0); }
        else { backward_encoders(); }
      }
    } else {
      @assert(barrier_action == 4);
      lifecycle[1] += 1;
      stats[1] = 1; stats[0] = 0x600D;
      tsc.get_timestamp(@ptrcast(*[3]u16, &clocks[3]));
      tsc.disable_tsc();
      sys.unblock_cmd_stream();
    }
  } else if (phase == 20) {
    phase = 21;
    if (px == source_owner%C) { my.reduce_fadds(source_owner/C, &panel_row, &panel_sum, L*H, progress_id); }
    else { @activate(progress_id); }
  } else if (phase == 21) {
    if (px == source_owner%C and py == source_owner/C) {
      for (@range(u16, L*H)) |i| { dh_previous[i] += panel_sum[i]; }
    }
    stats[11] += 1;
    // The all-PE barrier also acknowledges that the owner consumed its sum.
    begin_barrier(3);
  } else if (phase == 30) {
    phase = 31;
    if (px == 0) { my.reduce_fadds(0, &row_grad, &gradients, W+2, progress_id); }
    else { @activate(progress_id); }
  } else if (phase == 31) {
    phase = 32;
    if (px == 0) { my.broadcast(0, @ptrcast([*]u32, &gradients), W+2, progress_id); }
    else { @activate(progress_id); }
  } else if (phase == 32) {
    phase = 33;
    mx.broadcast(0, @ptrcast([*]u32, &gradients), W+2, progress_id);
  } else if (phase == 33) {
    const count_check = gradients[W+1]*scalars[1];
    @assert(count_check > 0.9999 and count_check < 1.0001);
    loss[0] = gradients[W];
    // All backward stages have completed with the old generation of weights.
    for (@range(u16, W)) |i| { weights[i] -= scalars[0]*gradients[i]; }
    stats[12] += 1;
    begin_barrier(4);
  } else { stats[15] = @as(u32, phase)+1; @assert(false); }
}

fn run() void {
  if (lifecycle[0] == 0) {
    mx.init(); my.init(); px = mx.pe_id; py = my.pe_id;
    lifecycle[0] = 1;
  } else { @assert(stats[0] == 0x600D); }
  @assert(counts[0] <= @as(u32, L) and counts[1] <= @as(u32, E));
  @assert(src_begin[0] == 0 and src_begin[P] == counts[1]);
  @assert(scalars[0] >= 0.0 and scalars[1] > 0.0);
  for (@range(u16, 16)) |i| { stats[i] = 0; }
  stats[13] = counts[0]; stats[14] = counts[1];
  for (@range(u16, W+2)) |i| { gradients[i] = 0.0; row_grad[i] = 0.0; }
  for (@range(u16, (S+1)*L*H)) |i| { h_history[i] = 0.0; }
  for (@range(u16, (S+1)*E*H)) |i| { e_history[i] = 0.0; }
  for (@range(u16, S*L*H)) |i| { aggregate_history[i] = 0.0; }
  for (@range(u16, L*H)) |i| { dh[i] = 0.0; }
  for (@range(u16, E*H)) |i| { de[i] = 0.0; sender_cache[i] = 0.0; }
  for (@range(u16, L*2)) |i| { prediction[i] = 0.0; }
  loss[0] = 0.0;
  tsc.enable_tsc(); tsc.get_timestamp(@ptrcast(*[3]u16, &clocks[0]));
  // Geometry is encoded anew every update because edge-encoder weights train.
  for (@range(u16, E)) |edge| {
    if (@as(u32, edge) < counts[1]) {
      @assert(src_owner[edge] < @as(u32, P));
      for (@range(u16, 3)) |f| { mlp_input[f] = edge_input[edge*3+f]; }
      mlp(3, H, NODE_ENCODER_SIZE, true);
      for (@range(u16, H)) |f| { e_history[edge*H+f] = mlp_output[f]; }
      stats[3] += 1;
    }
  }
  for (@range(u16, L)) |v| {
    if (@as(u32, v) < counts[0]) {
      for (@range(u16, 11)) |f| { mlp_input[f] = node_input[v*11+f]; }
      mlp(11, H, 0, true);
      for (@range(u16, H)) |f| { h_history[v*H+f] = mlp_output[f]; }
      stats[4] += 1;
    }
  }
  reversing = false; block = 0;
  begin_barrier(0);
}

var p_counts: [*]u32 = &counts;
var p_src_owner: [*]u32 = &src_owner;
var p_src_begin: [*]u32 = &src_begin;
var p_src_slot: [*]u32 = &src_slot;
var p_dst_slot: [*]u32 = &dst_slot;
var p_node_input: [*]f32 = &node_input;
var p_edge_input: [*]f32 = &edge_input;
var p_target: [*]f32 = &target;
var p_loss_mask: [*]f32 = &loss_mask;
var p_scalars: [*]f32 = &scalars;
var p_weights: [*]f32 = &weights;
var p_prediction: [*]f32 = &prediction;
var p_loss: [*]f32 = &loss;
var p_gradients: [*]f32 = &gradients;
var p_stats: [*]u32 = &stats;
var p_clocks: [*]u16 = &clocks;
var p_lifecycle: [*]u32 = &lifecycle;
comptime {
  @bind_local_task(progress, progress_id);
  @export_symbol(p_counts, "counts");
  @export_symbol(p_src_owner, "src_owner");
  @export_symbol(p_src_begin, "src_begin");
  @export_symbol(p_src_slot, "src_slot");
  @export_symbol(p_dst_slot, "dst_slot");
  @export_symbol(p_node_input, "node_input");
  @export_symbol(p_edge_input, "edge_input");
  @export_symbol(p_target, "target");
  @export_symbol(p_loss_mask, "loss_mask");
  @export_symbol(p_scalars, "scalars");
  @export_symbol(p_weights, "weights");
  @export_symbol(p_prediction, "prediction");
  @export_symbol(p_loss, "loss");
  @export_symbol(p_gradients, "gradients");
  @export_symbol(p_stats, "stats");
  @export_symbol(p_clocks, "clocks");
  @export_symbol(p_lifecycle, "lifecycle");
  @export_symbol(run);
}
