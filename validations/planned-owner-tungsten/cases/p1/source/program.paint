let host_in = color(0)
let host_out = color(1)
let down = color(23)
let odd = color(21)
let even = color(20)
let owner0 = tile(0 0)
owner0 : code('owner [X:0 ROWS:64 rx:host_in tx:down])
owner0 : paint(host_in [L>C])
owner0 : paint(down [C>U])
let gather0 = tile(0 1)
gather0 : code('collect [OWN:270 TRAILING:0 local_rx:down right_rx:even tx:host_out])
gather0 : paint(down [D>C])
gather0 : paint(host_out [C>L])
union(owner0 gather0)
