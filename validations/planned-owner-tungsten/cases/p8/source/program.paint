let owner0 = tile(0 0)
owner0 : code('owner [X:0 ROWS:8 rx:host_in tx:down])
owner0 : paint(host_in [L>CR])
owner0 : paint(down [C>U])
let gather0 = tile(0 1)
gather0 : code('collect [OWN:46 TRAILING:322 local_rx:down right_rx:even tx:host_out])
gather0 : paint(down [D>C])
gather0 : paint(host_out [C>L])
gather0 : paint(even [R>C])
