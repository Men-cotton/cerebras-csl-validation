let rx0=color(0)
let tx0=color(1)
let rx1=color(2)
let tx1=color(3)
let down=color(23)
let a=tile(0 0)
let b=tile(0 1)
let c=tile(0 18)
let d=tile(0 19)
a : code('echo [ARM:0 rx:rx0 tx:down])
a : paint(rx0 [L>C])
a : paint(down [C>U])
b : code('relay [rx:down tx:tx0])
b : paint(down [D>C])
b : paint(tx0 [C>L])
c : code('echo [ARM:1 rx:rx1 tx:down])
c : paint(rx1 [L>C])
c : paint(down [C>U])
d : code('relay [rx:down tx:tx1])
d : paint(down [D>C])
d : paint(tx1 [C>L])
union(a b c d)
