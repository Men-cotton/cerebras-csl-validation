// SPDX-License-Identifier: Apache-2.0
// H064: full-row feature shards and column-shared source panels.
param C: u16;
param R: u16;
param K: u16;
param L: u16;
param FW: u16;
param H: u16;
param O: u16;
param T: u16;
param MX: u16;
param MG: u16;
param COMPACT: u16;
param U: u16;
param NRX: u16;
param NSEND: u16;
param NPLAN: u16;
const memcpy = @import_module("<memcpy/get_params>", .{.width=C, .height=R});
const c2d = @import_module("<collectives_2d/params>");
layout {
  @set_rectangle(C, R);
  @comptime_assert(C >= 2 and R >= 2 and H == 16 and T == 8 and O == 7);
  @comptime_assert((@as(u32, K) + @as(u32, NRX)) * @as(u32, T) < 32768);
  @comptime_assert(COMPACT <= 1 and U >= 1 and U <= K and (COMPACT == 1 or U == K));
  for (@range(u16, C)) |x| {
    for (@range(u16, R)) |y| {
      const cp = c2d.get_params(x, y, .{
        // SDK 2.10 requires valid placeholder task IDs for its unused X dimension.
        .x_colors=.{@get_color(0), @get_color(1)},
        .x_entrypoints=.{@get_local_task_id(8), @get_local_task_id(9)},
        .y_colors=.{@get_color(4), @get_color(5)},
        .y_entrypoints=.{@get_local_task_id(10), @get_local_task_id(11)}
      });
      @set_tile_code(x, y, "pe.csl", .{
        .memcpy_params=memcpy.get_params(x), .c2d_params=cp, .even_column=(x%2 == 0),
        .C=C,.R=R,.K=K,.L=L,.FW=FW,.H=H,.O=O,.T=T,.MX=MX,.MG=MG,.NRX=NRX,.NSEND=NSEND,.NPLAN=NPLAN
      });
    }
  }
  @export_name("x_ptr", [*]u16, true);
  @export_name("x_col", [*]u16, true);
  @export_name("x_val", [*]f32, true);
  @export_name("w0", [*]f32, true);
  @export_name("w1", [*]f32, true);
  @export_name("edge_ptr", [*]u16, true);
  @export_name("split_control", [*]u16, true);
  @export_name("split_words", [*]u32, true);
  @export_name("edge_src", [*]u16, true);
  @export_name("edge_weight", [*]f32, true);
  @export_name("slots", [*]u16, true);
  @export_name("send_slot", [*]u16, true);
  @export_name("packet_header", [*]u32, true);
  @export_name("packet_tag", [*]u32, true);
  @export_name("packet_offset", [*]u16, true);
  @export_name("packet_count", [*]u16, true);
  @export_name("counts", [*]u16, true);
  @export_name("traffic", [*]u32, true);
  @export_name("pre", [*]f32, true);
  @export_name("logits", [*]f32, true);
  @export_name("panel_sum", [*]f32, true);
  @export_name("stats", [*]u32, true);
  @export_name("clocks", [*]u16, true);
  @export_name("f_run", fn()void);
}
