let host_in = color(0)
let host_out = color(1)
let down = color(23)
let odd = color(21)
let even = color(20)
let owner0 = tile(0 0)
owner0 : code('owner [X:0 ROWS:32 rx:host_in tx:down])
owner0 : paint(host_in [L>CR])
owner0 : paint(down [C>U])
let gather0 = tile(0 1)
gather0 : code('collect [OWN:136 TRAILING:136 local_rx:down right_rx:even tx:host_out])
gather0 : paint(down [D>C])
gather0 : paint(host_out [C>L])
gather0 : paint(even [R>C])
let owner1 = tile(1 0)
owner1 : code('owner [X:1 ROWS:32 rx:host_in tx:down])
owner1 : paint(host_in [L>C])
owner1 : paint(down [C>U])
let gather1 = tile(1 1)
gather1 : code('collect [OWN:136 TRAILING:0 local_rx:down right_rx:odd tx:even])
gather1 : paint(down [D>C])
gather1 : paint(even [C>L])
union(owner0 gather0 owner1 gather1)
