let host_in = color(0)
let host_out = color(1)
let net = bank(1)
let messages = color(net)
let rr = color()
let rrp = color()
let rb = color()
let yp = color()
let ypp = color()
let ym = color()
let ymp = color()

let east = color()
let eastp = color()
let routes = rect(0 0 C R)
routes : mp(net)
routes : paint(eastp [CXR|R])
routes : paint(east [L|LXC])
routes : colorpair(east eastp)
routes : paint(rrp [CXL|L])
routes : paint(rr [R|RXC])
routes : colorpair(rr rrp)
routes : paint(ypp [CXU|U])
routes : paint(yp [D|DXC])
routes : colorpair(yp ypp)
routes : paint(ymp [CXD|D])
routes : paint(ym [U|UXC])
routes : colorpair(ym ymp)

let left = rect(0 0 1 R)
left : paint(rb [C>R])
let middle = rect(1 0 C-2 R)
middle : paint(rb [L>CR])
let right = rect(C-1 0 1 R)
right : paint(rb [L>C])

let pe = tile()
pe : code('sage [east:east host_in:host_in host_out:host_out mp:messages NTX:NTX NRX:NRX rr:rr rb:rb yp:yp ym:ym C:C R:R K:K L:L FW:FW H:H O:O T:T MX:MX MG:MG U:U COMPACT:COMPACT X0:X0 Y0:Y0])
pe : hstackrep(C 0 'x)
pe : vstackrep(R 0 'y)
pe : name('grid)
let ingress = tile(0 0)
ingress : paint(host_in [L>C])
let egress = tile(0 1)
egress : paint(host_out [C>L])
let application = union(routes left middle right pe ingress egress)
application : place(X0 Y0)
application
