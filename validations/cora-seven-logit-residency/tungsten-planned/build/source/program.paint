let host_in = color(0)
let host_out = color(1)
let down = color(23)
let odd = color(21)
let even = color(20)
let owner0 = tile(0 0)
owner0 : code('owner [X:0 ROWS:16 rx:host_in tx:down])
owner0 : paint(host_in [L>CR])
owner0 : paint(down [C>U])
let gather0 = tile(0 1)
gather0 : code('collect [OWN:126 TRAILING:378 local_rx:down right_rx:even tx:host_out])
gather0 : paint(down [D>C])
gather0 : paint(host_out [C>L])
gather0 : paint(even [R>C])
let owner1 = tile(1 0)
owner1 : code('owner [X:1 ROWS:16 rx:host_in tx:down])
owner1 : paint(host_in [L>CR])
owner1 : paint(down [C>U])
let gather1 = tile(1 1)
gather1 : code('collect [OWN:126 TRAILING:252 local_rx:down right_rx:odd tx:even])
gather1 : paint(down [D>C])
gather1 : paint(even [C>L])
gather1 : paint(odd [R>C])
let owner2 = tile(2 0)
owner2 : code('owner [X:2 ROWS:16 rx:host_in tx:down])
owner2 : paint(host_in [L>CR])
owner2 : paint(down [C>U])
let gather2 = tile(2 1)
gather2 : code('collect [OWN:126 TRAILING:126 local_rx:down right_rx:even tx:odd])
gather2 : paint(down [D>C])
gather2 : paint(odd [C>L])
gather2 : paint(even [R>C])
let owner3 = tile(3 0)
owner3 : code('owner [X:3 ROWS:16 rx:host_in tx:down])
owner3 : paint(host_in [L>C])
owner3 : paint(down [C>U])
let gather3 = tile(3 1)
gather3 : code('collect [OWN:126 TRAILING:0 local_rx:down right_rx:odd tx:even])
gather3 : paint(down [D>C])
gather3 : paint(even [C>L])
union(owner0 gather0 owner1 gather1 owner2 gather2 owner3 gather3)
