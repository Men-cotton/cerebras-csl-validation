// SPDX-License-Identifier: Apache-2.0
// Feature-sharded GraphSAGE classifier, official collectives_2d callbacks.
param C: u16;
param R: u16;
param K: u16;
param L: u16;
param FW: u16;
param H: u16;
param O: u16;
param T: u16;
param MX: u16;
param MG: u16;
const memcpy = @import_module("<memcpy/get_params>", .{.width=C,.height=R});
const c2d = @import_module("<collectives_2d/params>");
layout {
  @set_rectangle(C,R);
  @comptime_assert(C >= 2 and R >= 2 and (T == 4 or T == 8 or T == 16));
  for (@range(u16,C)) |x| {
    for (@range(u16,R)) |y| {
      const cp = c2d.get_params(x,y,.{
        .x_colors=.{@get_color(0),@get_color(1)},
        .x_entrypoints=.{@get_local_task_id(8),@get_local_task_id(9)},
        .y_colors=.{@get_color(4),@get_color(5)},
        .y_entrypoints=.{@get_local_task_id(10),@get_local_task_id(11)}});
      @set_tile_code(x,y,"pe.csl",.{.memcpy_params=memcpy.get_params(x),.c2d_params=cp,
        .C=C,.R=R,.K=K,.L=L,.FW=FW,.H=H,.O=O,.T=T,.MX=MX,.MG=MG});
    }
  }
  @export_name("x_ptr",[*]u16,true);
  @export_name("x_col",[*]u16,true);
  @export_name("x_val",[*]f32,true);
  @export_name("ws0",[*]f32,true);
  @export_name("wn0",[*]f32,true);
  @export_name("ws1",[*]f32,true);
  @export_name("wn1",[*]f32,true);
  @export_name("b0",[*]f32,true);
  @export_name("b1",[*]f32,true);
  @export_name("g_ptr",[*]u16,true);
  @export_name("g_src",[*]u16,true);
  @export_name("g_val",[*]f32,true);
  @export_name("slots",[*]u16,true);
  @export_name("pre",[*]f32,true);
  @export_name("hidden",[*]f32,true);
  @export_name("logits",[*]f32,true);
  @export_name("stats",[*]u32,true);
  @export_name("clocks",[*]u16,true);
  @export_name("f_run",fn()void);
}
