let down=color(23)
let odd=color(21)
let even=color(20)
let cross=color(18)
let in0=color(0)
let out0=color(1)
let in1=color(2)
let out1=color(3)
let o0x0=tile(0 0)
o0x0 : code('owner0 [X:0 P:1 R:2 F:128 Q:16 E:8 RELU:1 FRAMES:9 N:4 SETUP:1334 rx:in0 tx:down])
o0x0 : paint(in0 [L>C])
o0x0 : paint(down [C>U])
let g0x0=tile(0 1)
g0x0 : code('final [P:2 R:2 H:16 N:4 Z:2 A:2 Q:40 FRAMES:9 SETUP:1334 local_rx:down right_rx:even lower_rx:cross tx:out0])
g0x0 : paint(cross [U>C])
g0x0 : paint(out0 [C>L])
g0x0 : paint(down [D>C])
let o1x0=tile(0 2)
o1x0 : code('owner1 [X:0 P:1 R:2 F:128 Q:16 E:8 RELU:1 FRAMES:9 N:4 SETUP:0 rx:in1 tx:down])
o1x0 : paint(in1 [L>C])
o1x0 : paint(down [C>U])
let g1x0=tile(0 3)
g1x0 : code('bridge [P:1 WORDS:50 FRAMES:9 local_rx:down right_rx:even fabric:cross done:out1])
g1x0 : paint(cross [C>D])
g1x0 : paint(out1 [C>L])
o1x0 : paint(cross [U>D])
g1x0 : paint(down [D>C])
union(o0x0 g0x0 o1x0 g1x0)
