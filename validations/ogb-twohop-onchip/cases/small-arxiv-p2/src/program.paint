let hin=color(0)
let hout=color(1)
let down=color(23)
let odd=color(21)
let even=color(20)
let o0=tile(0 0)
o0 : code('owner [X:0 P:2 R:2 F:128 Q:16 E:8 RELU:1 FRAMES:5 N:4 SETUP:1334 rx:hin tx:down])
o0 : paint(hin [L>CR])
o0 : paint(down [C>U])
let g0=tile(0 1)
g0 : code('final [P:2 R:2 H:16 N:4 Z:2 A:2 Q:40 FRAMES:5 SETUP:1334 local_rx:down right_rx:even tx:hout])
g0 : paint(down [D>C])
g0 : paint(hout [C>L])
g0 : paint(even [R>C])
let o1=tile(1 0)
o1 : code('owner [X:1 P:2 R:2 F:128 Q:16 E:8 RELU:1 FRAMES:5 N:4 SETUP:1334 rx:hin tx:down])
o1 : paint(hin [L>C])
o1 : paint(down [C>U])
let g1=tile(1 1)
g1 : code('collect [OWN:50 TRAILING:0 local_rx:down right_rx:odd tx:even])
g1 : paint(down [D>C])
g1 : paint(even [C>L])
union(o0 g0 o1 g1)
