param memcpy_params;
param R: i16; param F: i16; param V: i16; param Q: i16; param B: i16;
param X: i16; param Y: i16;
const sys = @import_module("<memcpy/memcpy>", memcpy_params);
const router = X == 0 and Y < R;
const worker = X > 0 and Y < R;
const accumulator = X > 0 and Y >= R;
const idxq = @get_input_queue(2);
const valq = @get_input_queue(3);
const northq = @get_input_queue(4);
const idxout = @get_output_queue(2);
const valout = @get_output_queue(3);
const southout = @get_output_queue(4);
const hostout = @get_output_queue(5);
const input_task = @get_data_task_id(idxq);
const north_task = @get_data_task_id(northq);
const reset_task = @get_local_task_id(9);
var h = @zeros([V]f32);
var y = @zeros([Q]f32);
// router: pairs/nonzeros/row markers/EMPTY; worker: MACs/rows/chunks/resets;
// accumulator: received words/forwarded words/stored words/output started.
var stats = @zeros([4]u32);
var h_ptr: [*]f32 = &h;
var stats_ptr: [*]u32 = &stats;
const yi = @get_dsd(mem1d_dsd, .{.tensor_access=|i|{Q}->y[i]});
var ya = @get_dsd(mem1d_dsd, .{.tensor_access=|i|{1}->y[i]});
const ai = @get_dsd(fabout_dsd, .{.extent=1,.output_queue=idxout});
const av = @get_dsd(fabout_dsd, .{.extent=1,.output_queue=valout});
const vin = @get_dsd(fabin_dsd, .{.extent=1,.input_queue=valq});
const ni = @get_dsd(fabin_dsd, .{.extent=Q,.input_queue=northq});
const so = @get_dsd(fabout_dsd, .{.extent=Q,.output_queue=southout});
const one_so = @get_dsd(fabout_dsd, .{.extent=1,.output_queue=southout});
const ho = sys.get_streaming_fabout_dsd(@get_color(1), Q, hostout);
var have_index: bool = false;
var index: u32 = 0;
var row: i16 = 0;
var received: i16 = 0;

task recv_host(word: u32) void {
  if (!have_index) { index = word; have_index = true; return; }
  have_index = false;
  stats[0] += 1;
  if (index == 0xffffffff) { stats[3] += 1; return; }
  if (index == 0xfffffffe) {
    var n: u32 = 0;
    while (n < word) { @mov16(ai, @as(u16, 0xffff)); n += 1; }
    stats[2] += word;
  } else {
    @mov16(ai, @as(u16, index - (@as(u32, Y)*@as(u32, V))));
    @mov32(av, word);
    stats[1] += 1;
  }
}

task recv_index(local_index: u16) void {
  if (local_index != 0xffff) {
    @fmacs(ya, ya, vin, h[local_index]);
    stats[0] += 1;
  } else {
    row += 1; stats[1] += 1;
    if (row == Q) {
      @block(input_task);
      stats[2] += 1;
      if (Y == 0) {
        @fmovs(so, yi, .{.async=true,.ut_id=@get_ut_id(4),.activate=reset_task});
      } else {
        @fadds(so, yi, ni, .{.async=true,.ut_id=@get_ut_id(4),.activate=reset_task});
      }
    } else { ya = @increment_dsd_offset(ya, 1, f32); }
  }
}

task reset() void {
  @fmovs(yi, @as(f32,0));
  ya = @set_dsd_base_addr(ya, &y);
  row = 0; stats[3] += 1;
  @unblock(input_task);
}

task recv_sum(word: u32) void {
  stats[0] += 1;
  if (received < Q) {
    y[received] = @bitcast(f32, word);
    received += 1; stats[2] += 1;
    if (received == Q) {
      // Separate microthread: later chunks can pass while host output waits.
      @fmovs(ho, yi, .{.async=true,.ut_id=@get_ut_id(5)});
      stats[3] = 1;
    }
  } else if (Y < R+B-1) {
    @mov32(one_so, word); stats[1] += 1;
  }
}

comptime {
  @export_symbol(h_ptr, "h");
  @export_symbol(stats_ptr, "stats");
  if (router) {
    @initialize_queue(idxq,.{.color=@get_color(0)});
    @initialize_queue(idxout,.{.color=@get_color(4)});
    @initialize_queue(valout,.{.color=@get_color(5)});
    @bind_data_task(recv_host,input_task);
  }
  if (worker) {
    @initialize_queue(idxq,.{.color=@get_color(4)});
    @initialize_queue(valq,.{.color=@get_color(5)});
    @initialize_queue(southout,.{.color=@get_color(6+Y%2)});
    if (Y > 0) { @initialize_queue(northq,.{.color=@get_color(6+(Y-1)%2)}); }
    @bind_data_task(recv_index,input_task);
    @bind_local_task(reset,reset_task);
  }
  if (accumulator) {
    @initialize_queue(northq,.{.color=@get_color(6+(Y-1)%2)});
    if (Y < R+B-1) { @initialize_queue(southout,.{.color=@get_color(6+Y%2)}); }
    @initialize_queue(hostout,.{.color=@get_color(1)});
    @bind_data_task(recv_sum,north_task);
  }
}
