send tx_w_X5_3 register(T23) = {.length=1, .utid=0, .upr=NONE, .qid=0, .transform=0, .lp=1, .control=0, .fs=0, .xc=0, };
send tx_w_X5_2 register(T22) = {.length=1, .utid=0, .upr=NONE, .qid=0, .transform=0, .lp=1, .control=0, .fs=0, .xc=0, };
