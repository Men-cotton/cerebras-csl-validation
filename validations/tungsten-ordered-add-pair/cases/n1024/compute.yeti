send tx_w_X6 register(T26) = {.length=1024, .utid=0, .upr=NONE, .qid=0, .transform=0, .lp=1, .control=0, .fs=0, .xc=0, };
vector out_src1_7 register(T11) = {.base=(out+0), .length=0, .stride=1, .save=0, .vp=0, .ua=0, .rchoasjt=0, };
vector out_dst_0 register(T20) = {.base=(out+0), .length=1024, .stride=1, .save=0, .vp=0, .ua=0, .rchoasjt=0, };
