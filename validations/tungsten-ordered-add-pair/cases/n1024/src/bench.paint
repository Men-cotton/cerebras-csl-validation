let host_in = color(0)
let host_out = color(1)
let down = color(23)
let compute = tile(0 0)
compute : code('pair [N:N rx:host_in tx:down])
compute : name('compute)
compute : paint(host_in [L>C])
compute : paint(down [C>U])
let relay = tile(0 1)
relay : code('relay [N:N rx:down tx:host_out])
relay : name('relay)
relay : paint(down [D>C])
relay : paint(host_out [C>L])
union(compute relay)
