// SPDX-License-Identifier: Apache-2.0
// Official gemv/gemm collectives_2d callback patterns; no message-passing root.
param memcpy_params;
param c2d_params;
param C: u16;
param R: u16;
param K: u16;
param L: u16;
param FW: u16;
param H: u16;
param O: u16;
param T: u16;
param MX: u16;
param MG: u16;
param COMPACT: u16;
param U: u16;
param MS: u16;
const sys = @import_module("<memcpy/memcpy>", memcpy_params);
const timestamp = @import_module("<time>");
const mpi_x = @import_module("<collectives_2d/pe>", .{
  .dim_params=c2d_params.x, .queues=[2]u16{2,4},
  .dest_dsr_ids=[1]u16{1}, .src0_dsr_ids=[1]u16{1}, .src1_dsr_ids=[1]u16{1}
});
const mpi_y = @import_module("<collectives_2d/pe>", .{
  .dim_params=c2d_params.y, .queues=[2]u16{3,5},
  .dest_dsr_ids=[1]u16{2}, .src0_dsr_ids=[1]u16{2}, .src1_dsr_ids=[1]u16{2}
});
const mp = @import_module("<message_passing>", .{
  .bank_id=14, .input_queue_id=6, .output_queue_id=6, .enable_asserts=true
});
const packet_tx_task = @get_local_task_id(16);
const packet_rx_task = @get_local_task_id(17);
const initialized_task = @get_local_task_id(18);
const tile_task = @get_local_task_id(12);
const reduced_task = @get_local_task_id(13);
const shared_task = @get_local_task_id(14);
const received_task = @get_local_task_id(15);

var x_ptr = @zeros([K+1]u16);
var x_col = @zeros([MX]u16);
var x_val = @zeros([MX]f32);
var w0 = @zeros([FW*H]f32);
var w1 = @zeros([H*O]f32);
var g_ptr = @zeros([R*L+1]u16);
var g_src = @zeros([MG]u16);
var g_val = @zeros([MG]f32);
var slots = @zeros([L]u16);
// The matched full arm uploads the same immutable directories.
var sender_slots = @zeros([K]u16);
var source_lengths = @zeros([R]u16);
var send_ptr = @zeros([R+1]u16);
var send_slots = @zeros([MS]u16);
var recv_lengths = @zeros([R]u16);
var transport_stats = @zeros([6]u32);
// Full legal fixed-body capacity plus two guards; TX and RX never alias.
var packet_tx = @zeros([33]u32);
var packet_rx = @zeros([33]u32);
var init_one = [1]f32{1.0};
var init_sum = @zeros([1]f32);
var release_token = @zeros([1]u32);
var epoch: u32 = 0;
var target_row: u16 = 0;
var packet_index: u16 = 0;
const packet_guard: u32 = 0xc0dec0de;
var pre = @zeros([L*H]f32);
var logits = @zeros([L*O]f32);
var panel_local = @zeros([K*T]f32);
// Home panel survives all column broadcasts. RX never overwrites it.
var panel_sum = @zeros([K*T]f32);
var panel_rx = @zeros([U*T]f32);
var accum = @zeros([L*T]f32);
var stats = @zeros([8]u32);
var clocks = @zeros([6]u16);
const lane_dsd = @get_dsd(mem1d_dsd, .{.tensor_access=|i|{T}->panel_local[i]});
const local_dsd = @get_dsd(mem1d_dsd, .{.tensor_access=|i|{K*T}->panel_local[i]});
const sum_dsd = @get_dsd(mem1d_dsd, .{.tensor_access=|i|{K*T}->panel_sum[i]});
const rx_dsd = @get_dsd(mem1d_dsd, .{.tensor_access=|i|{U*T}->panel_rx[i]});
const accum_dsd = @get_dsd(mem1d_dsd, .{.tensor_access=|i|{L*T}->accum[i]});
const pre_dsd = @get_dsd(mem1d_dsd, .{.tensor_access=|i|{L*H}->pre[i]});
const logits_dsd = @get_dsd(mem1d_dsd, .{.tensor_access=|i|{L*O}->logits[i]});

var phase: u16 = 0;
var lane: u16 = 0;
var source_group: u16 = 0;
var py: u16 = 0;

fn f_run() void {
  mp.init();
  mpi_x.init();
  mpi_y.init();
  py = mpi_y.pe_id;
  phase = 0;
  lane = 0;
  for (@range(u16, 8)) |i| { stats[i] = 0; }
  @fmovs(pre_dsd, 0.0);
  @fmovs(logits_dsd, 0.0);
  timestamp.enable_tsc();
  timestamp.get_timestamp(@ptrcast(*[3]u16, &clocks[0]));
  @assert(epoch < 0xffffffff);
  epoch += 1;
  for (@range(u16, 6)) |i| { transport_stats[i] = 0; }
  transport_stats[5] = epoch;
  packet_tx[0] = packet_guard; packet_tx[32] = packet_guard;
  packet_rx[0] = packet_guard; packet_rx[32] = packet_guard;
  // Join all MP initialization before any source can inject a DATA header.
  mpi_y.reduce_fadds(0, &init_one, &init_sum, 1, initialized_task);
}

task initialized() void {
  mpi_y.broadcast(0, @ptrcast([*]u32, &init_sum), 1, tile_task);
}

task compute_tile() void {
  const width = if (phase == 0) H else O;
  const active = if (lane+T <= width) T else width-lane;
  const active_dsd = @set_dsd_length(lane_dsd, active);
  @fmovs(local_dsd, 0.0);
  @fmovs(sum_dsd, 0.0);
  @fmovs(rx_dsd, 0.0);
  @fmovs(accum_dsd, 0.0);
  if (phase == 0) {
    for (@range(u16, K)) |v| {
      const output = @set_dsd_base_addr(active_dsd, @ptrcast([*]f32, &panel_local[v*T]));
      var e = x_ptr[v];
      while (e < x_ptr[v+1]) : (e += 1) {
        const input = @set_dsd_base_addr(active_dsd, @ptrcast([*]f32, &w0[x_col[e]*H+lane]));
        @fmacs(output, output, input, x_val[e]);
        stats[4] += @as(u32, active);
      }
    }
  } else {
    // Exactly one owner contributes each row; row reduction assembles the panel.
    for (@range(u16, L)) |v| {
      if (slots[v] != 65535) {
        const output = @set_dsd_base_addr(active_dsd, @ptrcast([*]f32, &panel_local[slots[v]*T]));
        for (@range(u16, H)) |h| {
          const value = if (pre[v*H+h] > 0.0) pre[v*H+h] else @as(f32, 0.0);
          const input = @set_dsd_base_addr(active_dsd, @ptrcast([*]f32, &w1[h*O+lane]));
          @fmacs(output, output, input, value);
          stats[6] += @as(u32, active);
        }
      }
    }
  }
  mpi_x.reduce_fadds(0, &panel_local, &panel_sum, K*T, reduced_task);
}

task reduced() void {
  stats[1] += 1;
  mpi_x.broadcast(0, @ptrcast([*]u32, &panel_sum), K*T, shared_task);
}

fn packet_tag() u32 { return (@as(u32, phase) << 16) | @as(u32, lane); }

fn guards() void {
  @assert(packet_tx[0] == packet_guard and packet_tx[32] == packet_guard);
  @assert(packet_rx[0] == packet_guard and packet_rx[32] == packet_guard);
}

fn release_group() void {
  guards();
  release_token[0] = epoch;
  transport_stats[4] += 1;
  mpi_y.broadcast(source_group, &release_token, 1, received_task);
}

fn receive_packet() void {
  // Called only after any local TX callback has completed.
  guards();
  mp.recv_message(@ptrcast([*]u32, &packet_rx[1]), .{.activate=packet_rx_task});
}

fn send_next() void {
  while (target_row < R and send_ptr[target_row] == send_ptr[target_row+1]) {
    target_row += 1;
  }
  if (target_row == R) { release_group(); return; }
  @assert(target_row != py);
  const entry = send_ptr[target_row]+packet_index;
  @assert(entry < send_ptr[target_row+1] and entry < MS);
  const slot = send_slots[entry];
  @assert(slot < K);
  packet_tx[1] = epoch;
  packet_tx[2] = packet_tag();
  packet_tx[3] = @as(u32, source_group);
  packet_tx[4] = @as(u32, packet_index);
  for (@range(u16, T)) |i| { packet_tx[5+i] = @bitcast(u32, panel_sum[slot*T+i]); }
  transport_stats[0] += 1;
  mp.send_message(mpi_x.pe_id, target_row, @ptrcast([*]u32, &packet_tx[1]), T+4,
                  .{.activate=packet_tx_task});
}

fn broadcast_source() void {
  packet_index = 0;
  if (py == source_group) {
    target_row = 0;
    send_next();
  } else if (recv_lengths[source_group] == 0) {
    release_group();
  } else {
    receive_packet();
  }
}

task packet_sent() void {
  guards();
  if (py == source_group) {
    packet_index += 1;
    if (send_ptr[target_row]+packet_index < send_ptr[target_row+1]) {
      send_next();
    } else {
      // Source TX is complete before blocking on the target cache ACK.
      receive_packet();
    }
  } else {
    // ACK body has left TX storage. Cache stays live until received() consumes it.
    release_group();
  }
}

task packet_received() void {
  guards();
  @assert(packet_rx[1] == epoch and packet_rx[2] == packet_tag());
  @assert(packet_rx[3] == @as(u32, source_group));
  if (py == source_group) {
    @assert(packet_rx[4] == @as(u32, target_row));
    transport_stats[3] += 1;
    target_row += 1;
    packet_index = 0;
    send_next();
  } else {
    @assert(packet_rx[4] == @as(u32, packet_index));
    @assert(packet_index < recv_lengths[source_group] and packet_index < U);
    for (@range(u16, T)) |i| { panel_rx[packet_index*T+i] = @bitcast(f32, packet_rx[5+i]); }
    transport_stats[1] += 1;
    packet_index += 1;
    if (packet_index < recv_lengths[source_group]) {
      receive_packet();
    } else {
      packet_tx[1] = epoch;
      packet_tx[2] = packet_tag();
      packet_tx[3] = @as(u32, source_group);
      packet_tx[4] = @as(u32, py);
      transport_stats[2] += 1;
      mp.send_message(mpi_x.pe_id, source_group, @ptrcast([*]u32, &packet_tx[1]), 4,
                      .{.activate=packet_tx_task});
    }
  }
}

task shared() void {
  stats[2] += 1;
  source_group = 0;
  broadcast_source();
}

task received() void {
  @assert(release_token[0] == epoch);
  stats[3] += 1;
  const buffer: [*]f32 = if (py == source_group) &panel_sum else &panel_rx;
  const width = if (phase == 0) H else O;
  const active = if (lane+T <= width) T else width-lane;
  const active_dsd = @set_dsd_length(lane_dsd, active);
  const input_base = @set_dsd_base_addr(active_dsd, buffer);
  for (@range(u16, L)) |v| {
    const output = @set_dsd_base_addr(active_dsd, @ptrcast([*]f32, &accum[v*T]));
    const row = source_group*L+v;
    var e = g_ptr[row];
    while (e < g_ptr[row+1]) : (e += 1) {
      const input = @increment_dsd_offset(input_base, @as(i16, g_src[e]*T), f32);
      @fmacs(output, output, input, g_val[e]);
      stats[5] += @as(u32, active);
    }
  }
  source_group += 1;
  if (source_group < R) {
    broadcast_source();
  } else {
    for (@range(u16, L)) |v| {
      for (@range(u16, T)) |t| {
        if (lane+t < width) {
          if (phase == 0) { pre[v*H+lane+t] = accum[v*T+t]; }
          else { logits[v*O+lane+t] = accum[v*T+t]; }
        }
      }
    }
    stats[7] += 1;
    lane += T;
    if (lane < width) {
      @activate(tile_task);
    } else if (phase == 0) {
      phase = 1;
      lane = 0;
      @activate(tile_task);
    } else {
      timestamp.get_timestamp(@ptrcast(*[3]u16, &clocks[3]));
      timestamp.disable_tsc();
      stats[0] = 0x600D;
      sys.unblock_cmd_stream();
    }
  }
}

// Exports require global pointer symbols, as in the official GEMV example.
var ptr_x_ptr: [*]u16 = &x_ptr;
var ptr_x_col: [*]u16 = &x_col;
var ptr_x_val: [*]f32 = &x_val;
var ptr_w0: [*]f32 = &w0;
var ptr_w1: [*]f32 = &w1;
var ptr_g_ptr: [*]u16 = &g_ptr;
var ptr_g_src: [*]u16 = &g_src;
var ptr_g_val: [*]f32 = &g_val;
var ptr_slots: [*]u16 = &slots;
var ptr_sender_slots: [*]u16 = &sender_slots;
var ptr_source_lengths: [*]u16 = &source_lengths;
var ptr_send_ptr: [*]u16 = &send_ptr;
var ptr_send_slots: [*]u16 = &send_slots;
var ptr_recv_lengths: [*]u16 = &recv_lengths;
var ptr_transport_stats: [*]u32 = &transport_stats;
var ptr_pre: [*]f32 = &pre;
var ptr_logits: [*]f32 = &logits;
var ptr_panel_sum: [*]f32 = &panel_sum;
var ptr_stats: [*]u32 = &stats;
var ptr_clocks: [*]u16 = &clocks;

comptime {
  @comptime_assert(T+4 < 32);
  @bind_local_task(packet_sent, packet_tx_task);
  @bind_local_task(packet_received, packet_rx_task);
  @bind_local_task(initialized, initialized_task);
  @export_symbol(ptr_send_ptr, "send_ptr");
  @export_symbol(ptr_send_slots, "send_slots");
  @export_symbol(ptr_recv_lengths, "recv_lengths");
  @export_symbol(ptr_transport_stats, "transport_stats");
  @bind_local_task(compute_tile, tile_task);
  @bind_local_task(reduced, reduced_task);
  @bind_local_task(shared, shared_task);
  @bind_local_task(received, received_task);
  @export_symbol(ptr_x_ptr, "x_ptr");
  @export_symbol(ptr_x_col, "x_col");
  @export_symbol(ptr_x_val, "x_val");
  @export_symbol(ptr_w0, "w0");
  @export_symbol(ptr_w1, "w1");
  @export_symbol(ptr_g_ptr, "g_ptr");
  @export_symbol(ptr_g_src, "g_src");
  @export_symbol(ptr_g_val, "g_val");
  @export_symbol(ptr_slots, "slots");
  @export_symbol(ptr_sender_slots, "sender_slots");
  @export_symbol(ptr_source_lengths, "source_lengths");
  @export_symbol(ptr_pre, "pre");
  @export_symbol(ptr_logits, "logits");
  @export_symbol(ptr_panel_sum, "panel_sum");
  @export_symbol(ptr_stats, "stats");
  @export_symbol(ptr_clocks, "clocks");
  @export_symbol(f_run);
}
