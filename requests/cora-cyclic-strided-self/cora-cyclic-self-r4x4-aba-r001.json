{
  "description": "Strided self-edge SIMD on cyclic source placement, 16 PEs, all Cora outputs, resident A/-A/A.",
  "id": "cora-cyclic-self-r4x4-aba-r001",
  "schema": 1,
  "steps": [
    {
      "args": [
        "compile-csl",
        "--shards",
        "4",
        "--out",
        "{output}/compile-csl"
      ],
      "kind": "appliance",
      "name": "compile-csl",
      "script": "validations/cora-cyclic-strided-self/r4/appliance.py"
    },
    {
      "args": [
        "run-csl",
        "--shards",
        "4",
        "--out",
        "{output}/run-csl",
        "--build",
        "{output}/compile-csl/build.json"
      ],
      "kind": "appliance",
      "name": "run-csl",
      "script": "validations/cora-cyclic-strided-self/r4/appliance.py"
    },
    {
      "args": [
        "run-tungsten",
        "--shards",
        "4",
        "--out",
        "{output}/run-tungsten"
      ],
      "kind": "appliance",
      "name": "run-tungsten",
      "script": "validations/cora-cyclic-strided-self/r4/appliance.py"
    }
  ]
}
