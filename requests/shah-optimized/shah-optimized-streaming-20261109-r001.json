{
  "schema": 1,
  "id": "shah-optimized-streaming-20261109-r001",
  "description": "Independent Shah optimized streaming reconstruction: fixed source, random sparse duplicates/empty shards, channels1/4, buffered/per-chunk output. Local R8/F8 mechanism passed; R16/F16 is the next hardware rung. Single observations, not a throughput conclusion.",
  "steps": [
    {
      "name": "r8-c1-compile",
      "script": "validations/shah-optimized/appliance.py",
      "args": [
        "compile",
        "--R",
        "8",
        "--F",
        "8",
        "--V",
        "16",
        "--Q",
        "8",
        "--B",
        "8",
        "--channels",
        "1",
        "--workload",
        "random",
        "--seed",
        "7",
        "--degree",
        "8",
        "--out",
        "{output}/r8-c1/compile"
      ],
      "kind": "appliance"
    },
    {
      "name": "r8-c1-buffered",
      "script": "validations/shah-optimized/appliance.py",
      "args": [
        "run",
        "--artifact-record",
        "{output}/r8-c1/compile/build.json",
        "--output-mode",
        "buffered",
        "--host-timeout",
        "300",
        "--out",
        "{output}/r8-c1/buffered"
      ],
      "kind": "appliance"
    },
    {
      "name": "r8-c1-buffered-audit",
      "script": "validations/shah-optimized/appliance.py",
      "args": [
        "audit",
        "--artifact-record",
        "{output}/r8-c1/compile/build.json",
        "--capture",
        "{output}/r8-c1/buffered",
        "--out",
        "{output}/r8-c1/buffered-audit.json"
      ],
      "kind": "host"
    },
