        "compile",
        "--R",
        "8",
        "--F",
        "8",
        "--V",
        "32",
        "--Q",
        "16",
        "--B",
        "8",
        "--channels",
        "4",
        "--workload",
        "balanced",
        "--degree",
        "2",
        "--seed",
        "7",
        "--out",
        "{output}/f8/compile"
      ],
      "kind": "appliance"
    },
