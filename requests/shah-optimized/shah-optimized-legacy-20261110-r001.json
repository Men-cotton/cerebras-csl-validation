        "--F",
        "8",
        "--V",
        "16",
        "--Q",
        "8",
        "--B",
        "8",
        "--channels",
        "1",
        "--workload",
        "random",
        "--degree",
        "8",
        "--seed",
        "7",
        "--out",
        "{output}/r8-c1/compile"
      ],
      "kind": "appliance"
    },
