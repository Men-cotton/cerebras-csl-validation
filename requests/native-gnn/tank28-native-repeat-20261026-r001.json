      "kind": "appliance",
      "timeout_seconds": 1200,
      "args": [
        "compile",
        "--case",
        "trained-c64-streamed",
        "--backend",
        "hardware",
        "--namespace",
        "job-operator",
        "--compile-workers",
        "4",
        "--out",
        "{output}/compile-trained-c64-streamed"
