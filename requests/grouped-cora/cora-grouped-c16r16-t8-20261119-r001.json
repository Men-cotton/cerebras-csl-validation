{
  "description": "Compile, execute and independently audit full Cora on 256 PEs with C16/T8",
  "id": "cora-grouped-c16r16-t8-20261119-r001",
  "schema": 1,
  "steps": [
    {
      "args": [
        "compile",
        "--case",
        "c16-r16-t8-group",
        "--backend",
        "hardware",
        "--namespace",
        "job-operator",
        "--compile-workers",
        "1",
        "--out",
        "{output}/compile-c16-r16-t8-group"
      ],
      "kind": "appliance",
      "name": "compile-c16-r16-t8-group",
      "script": "validations/grouped-cora/appliance.py"
    },
    {
      "args": [
        "run",
        "--case",
        "c16-r16-t8-group",
        "--backend",
        "hardware",
        "--artifact-record",
        "{output}/compile-c16-r16-t8-group/native-build.json",
        "--host-timeout",
        "600",
        "--out",
        "{output}/run-c16-r16-t8-group"
      ],
      "kind": "appliance",
      "name": "run-c16-r16-t8-group",
      "script": "validations/grouped-cora/appliance.py"
    },
    {
      "args": [
        "{output}/run-c16-r16-t8-group/capture-data",
        "--out",
        "{output}/numerical-c16-r16-t8-group.json"
      ],
      "kind": "host",
      "name": "audit-c16-r16-t8-group",
      "script": "validations/grouped-cora/saved_audit.py"
    }
  ]
}
