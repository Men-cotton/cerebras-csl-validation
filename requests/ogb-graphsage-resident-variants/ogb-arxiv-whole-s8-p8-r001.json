      "args": [
        "compile-csl",
        "--case",
        "arxiv-whole-s8-p8",
        "--out",
        "{output}/compile-csl"
      ]
    },
    {
      "name": "run-csl",
      "kind": "appliance",
      "script": "validations/ogb-graphsage-resident-variants/variant.py",
      "args": [
        "run-csl",
        "--case",
        "arxiv-whole-s8-p8",
        "--out",
        "{output}/run-csl",
