        "{output}/compile-csl/compiled.json"
      ]
    },
    {
      "name": "run-tungsten",
      "kind": "appliance",
      "script": "validations/ogb-graphsage-resident-variants/variant.py",
      "args": [
        "run-tungsten",
        "--case",
        "arxiv-whole-s8-p8",
        "--out",
        "{output}/run-tungsten",
        "--peer",
        "{output}/run-csl/capture.zip"
      ]
    }
  ],
  "description": "Measure changed csl, tungsten firmware on the identical resident two-layer arxiv graph and trained model."
}
